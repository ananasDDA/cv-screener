# OpenRouter API key (https://openrouter.ai/keys). Never commit the real .env.
OPENROUTER_API_KEY=
# Chat model for generation and the agent. Any OpenRouter model id with tool-calling support.
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# Optional: comma-separated fallbacks tried in order when the primary model errors or is rate-limited.
OPENROUTER_FALLBACK_MODELS=google/gemma-4-31b-it:free,nvidia/nemotron-3-super-120b-a12b:free
